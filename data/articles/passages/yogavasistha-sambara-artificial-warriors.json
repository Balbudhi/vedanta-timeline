        {"i":3,"iast":"ca","deva":"च","gloss":"also","parts":[{"form":"ca","gloss":"and; also"}],"stem":"ca","root":null,"affix":"avyaya","morph":"indeclinable conjunction","karaka":"additive"},
        {"i":4,"iast":"prāktanāḥ","deva":"प्राक्तनाः","gloss":"former; belonging to what preceded","parts":[{"form":"prāk","gloss":"before"},{"form":"-tana","gloss":"belonging to that time"},{"form":"-āḥ","gloss":"nominative plural"}],"stem":"prāktana","root":null,"affix":"ṭyu/tana temporal derivative + jas","morph":"nominative plural feminine","karaka":"qualifies vāsanāḥ"},
        {"i":5,"iast":"na","deva":"न","gloss":"not; no","parts":[{"form":"na","gloss":"not"}],"stem":"na","root":null,"affix":"avyaya","morph":"indeclinable negative","karaka":"negates the understood existential"},

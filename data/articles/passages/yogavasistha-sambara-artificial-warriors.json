        {"i":2,"iast":"ghorān","deva":"घोरान्","gloss":"terrible; formidable","parts":[{"form":"ghora","gloss":"terrible; formidable"},{"form":"-ān","gloss":"accusative plural"}],"stem":"ghora","root":null,"affix":"śas (dvitīyā-bahuvacana)","morph":"accusative plural masculine","karaka":"qualifies asurān"},

      "words": [
        {"i":0,"iast":"dāmaḥ","deva":"दामः","gloss":"Dāma","parts":[{"form":"Dāma","gloss":"proper name"}],"stem":"dāma","root":null,"affix":"su (prathamā-ekavacana)","morph":"nominative singular masculine","karaka":"first item in the iti-closed name list"},
        {"i":1,"iast":"vyālaḥ","deva":"व्यालः","gloss":"Vyāla","parts":[{"form":"Vyāla","gloss":"proper name"}],"stem":"vyāla","root":null,"affix":"su (prathamā-ekavacana)","morph":"nominative singular masculine","karaka":"second item in the name list"},
        {"i":2,"iast":"kaṭaḥ","deva":"कटः","gloss":"Kaṭa","parts":[{"form":"Kaṭa","gloss":"proper name"}],"stem":"kaṭa","root":null,"affix":"su (prathamā-ekavacana)","morph":"nominative singular masculine","karaka":"third item in the name list"},
        {"i":3,"iast":"ca","deva":"च","gloss":"and","parts":[{"form":"ca","gloss":"and"}],"stem":"ca","root":null,"affix":"avyaya","morph":"indeclinable conjunction","karaka":"coordinates the third name"},
        {"i":4,"iast":"iti","deva":"इति","gloss":"thus; closes the name list","parts":[{"form":"iti","gloss":"thus"}],"stem":"iti","root":null,"affix":"avyaya","morph":"indeclinable quotative","karaka":"closes the cited names"},
        {"i":5,"iast":"nāmabhiḥ","deva":"नामभिः","gloss":"by the names","parts":[{"form":"nāman","gloss":"name"},{"form":"-bhiḥ","gloss":"by"}],"stem":"nāman","root":null,"affix":"bhis (tṛtīyā-bahuvacana)","morph":"instrumental plural neuter","karaka":"karaṇa with parilāñchitāḥ"},
        {"i":6,"iast":"parilāñchitāḥ","deva":"परिलाञ्छिताः","gloss":"marked; designated","parts":[{"form":"pari-","gloss":"all around; fully"},{"form":"√lāñch","gloss":"mark"},{"form":"-ita","gloss":"marked"},{"form":"-āḥ","gloss":"nominative plural"}],"stem":"parilāñchita","root":"pari-√lāñch (bhvādi, 1P)","rootGloss":"to mark; designate","affix":"kta with iṭ + jas (prathamā-bahuvacana)","morph":"past participle, nominative plural masculine","karaka":"predicate of the three","rootEvidence":{"locus":"01.0235","aupadeshika_devanagari":"लाछिँ","artha_sanskrit":"लक्षणे"}},
        {"i":7,"iast":"yathā-prāpta-eka-kartāraḥ","deva":"यथाप्राप्तैककर्तारः","gloss":"doers only of whatever had presented itself","parts":[{"form":"yathā","gloss":"according as; whatever"},{"form":"pra-√āp-ta","gloss":"had arrived or presented itself"},{"form":"eka","gloss":"only; single"},{"form":"kartṛ","gloss":"doer"}],"stem":"yathā-prāpta-eka-kartṛ","root":"√kṛ (tanādi, 8U); pra-√āp (svādi, 5P)","rootGloss":"to do; to reach or present itself","affix":"kartṛ: tṛc + jas (prathamā-bahuvacana); prāpta: kta","morph":"nominative plural masculine compound","karaka":"predicate of the three","compound":{"type":"bahuvrīhi with an internal yathā-prāpta expression","vigraha":"yathā prāptaṃ tad eva kurvanti ye te","members":["yathā","prāpta","eka","kartṛ"]},"rootEvidence":{"kri":{"locus":"08.0010","aupadeshika_devanagari":"डुकृञ्","artha_sanskrit":"करणे"},"ap":{"locus":"05.0016","aupadeshika_devanagari":"आपॢँ","artha_sanskrit":"व्याप्तौ"}}},
        {"i":8,"iast":"cetanā-mātra-dharmiṇaḥ","deva":"चेतनामात्रधर्मिणः","gloss":"having cetanā alone as their defining property","parts":[{"form":"cetanā","gloss":"cetanā; animation, sentient responsiveness"},{"form":"mātra","gloss":"only; no more than"},{"form":"dharmin","gloss":"property-bearer; characterized by"}],"stem":"cetanā-mātra-dharmin","root":null,"affix":"jas (prathamā-bahuvacana)","morph":"nominative plural masculine compound","karaka":"predicate of the three","compound":{"type":"bahuvrīhi","vigraha":"cetanā-mātram eva dharmo yeṣāṃ te","members":["cetanā","mātra","dharmin"]},"note":"The compound says what property they bear; it does not by itself define cetanā as a complete metaphysics of consciousness."}

        {"i":6,"iast":"bala-rakṣā-artham","deva":"बलरक्षार्थम्","gloss":"for the protection of the force","parts":[{"form":"bala","gloss":"force; army"},{"form":"rakṣā","gloss":"protection"},{"form":"artha","gloss":"purpose"}],"stem":"bala-rakṣā-artha","root":"√rakṣ (bhvādi, 1P)","rootGloss":"to protect","affix":"aṅ in rakṣā + am (dvitīyā-ekavacana neuter), adverbial purpose","morph":"accusative singular neuter used adverbially","karaka":"purpose of their arising","compound":{"type":"ṣaṣṭhī-tatpuruṣa nested with artha","vigraha":"balasya rakṣā, tasyā artham","members":["bala","rakṣā","artha"]},"rootEvidence":{"locus":"01.0746","aupadeshika_devanagari":"रक्षँ","artha_sanskrit":"पालने"}},

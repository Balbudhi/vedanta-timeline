.DS_Store
node_modules/
*.log
.snap-tool/
.claude/
# Developer-side symlink used by the local server to serve primary texts at
# /materials/primary_texts/<...>. The citation panel's Source tab fetches
# from that path. Deployment provisions the same path separately.
# Developer-side symlink to ../materials/ used by the local server. The
# Source tab fetches from data/sources/ (the in-repo mirror) on the live
# site; this symlink is for local dev only.
/materials
.dns-backup/
sin_research/
# Gītā reading-page scratch: grounded-source extracts, audit report, and the
# full Aurobindo epub text (copyrighted — only short cited excerpts ship in
# aurobindo.js). Local-only.
gita/*/_build/
# Raw HTML downloads of primary sources — the cleaned .txt is what we keep.
data/sources/**/*_RAW.htm
# Acquired texts whose licence could not be established. This repo is public
# and ships only material we can show a licence for, so these stay local until
# their rights status is settled. See data/sources/_unverified_ocr/README.md.
/_acquisition_holding/
# Local, auditable API transcription passes. They can contain private source
# audio-derived text and must never be published automatically.
bhakti/*/.transcription/
__pycache__/

# Local agent/tooling scratch and Python virtualenvs — never part of the site.
.omx/
venv_gemini/

# Root-level scratch from the Bhakti audio-timing work, which now lives on its
# own site. Untracked so it cannot be swept into a commit.
/get_timings.py

# Raw recitation sources and intermediates in the private audio store (320 kbps originals under ND licences): never commit.
internal/audio/**/*_source.mp3
internal/audio/**/*.wav
# Gītā review store: packets, producer shards, reviews and deviation files quote
# copyrighted secondary translations in full. They stay local (standard §9).
internal/sanskrit_reviews/gita/**/packet.json
internal/sanskrit_reviews/gita/**/producer-*.json
internal/sanskrit_reviews/gita/**/independent-review-*.json
internal/sanskrit_reviews/gita/**/meaning-review-*.json
internal/sanskrit_reviews/gita/**/meaning-review-*.md
internal/sanskrit_reviews/gita/**/deviations.json
internal/sanskrit_reviews/gita/**/devanagari-collation.json
internal/sanskrit_reviews/gita/**/owner-review-queue.json
# Gītā pipeline working state (packets, job outputs, reviews quoting other translations): local only.
internal/gita_pipeline/
# Owner chat quotations and the design critique trail: private working files.
docs/gita_briefs/REQUIREMENTS_REGISTER.md
docs/gita_briefs/gan_review/
